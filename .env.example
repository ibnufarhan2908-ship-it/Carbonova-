# ===================================================
# EMAIL GURU RESMI TEPERCAYA (WHITELIST TUNGGAL AD11-01)
# ===================================================
# Tetapkan satu email guru tepercaya resmi di lingkungan produksi
VITE_TEACHER_EMAIL=guru@carbonova.com
TEACHER_EMAIL=guru@carbonova.com

# ===================================================
# KODE RAHASIA UNDANGAN REGISTRASI GURU CARBONOVA (LEGACY)
# ===================================================
TEACHER_INVITATION_CODE=GURU-CARBONOVA-2026
VITE_TEACHER_INVITATION_CODE=GURU-CARBONOVA-2026

# ===================================================
# CARBONOVA — FIREBASE & FIRESTORE CONFIGURATION
# ===================================================
# Dapatkan nilai-nilai ini dari:
# Firebase Console -> Project Settings -> General -> Your apps -> SDK setup and configuration

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
