rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Trusted teacher whitelist (UIDs or demo email)
    function isTrustedTeacher() {
      return isSignedIn() && (
        request.auth.token.email == 'guru.demo@carbonova.test' ||
        request.auth.uid == 'usr-teacher-01' ||
        request.auth.uid == 'demo-guru-carbonova'
      );
    }

    // Teacher or teacher_demo role (stored in user profile) can read everything needed
    function isTeacherOrDemo() {
      return isSignedIn() && (
        isTrustedTeacher() ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['teacher', 'teacher_demo']
      );
    }

    // ---------------------------------------------------------------------
    // 1. Users collection
    // - Students can read their own profile only
    // - Teachers (trusted or with role teacher/teacher_demo) can read all profiles
    // - Creation allowed for self with role student (cannot set teacher role)
    // - Updates allowed for self unless changing role to teacher/teacher_demo
    // - Deletion allowed for teachers only
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isOwner(userId) || isTeacherOrDemo();

      allow create: if isOwner(userId) && (
        isTeacherOrDemo() ||
        (
          request.resource.data.role in ['student', 'siswa'] &&
          request.resource.data.role != 'teacher' &&
          request.resource.data.role != 'guru'
        )
      );

      allow update: if isOwner(userId) && (
        isTeacherOrDemo() ||
        (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) ||
          request.resource.data.role in ['student', 'siswa']
        )
      );

      allow delete: if isTeacherOrDemo();
    }

    // ---------------------------------------------------------------------
    // 2. Quiz submissions
    // - Teachers can read all submissions
    // - Students can read only their own submissions
    // - Creation allowed for the authenticated student
    // - Updates/Deletes allowed for teachers only
    // ---------------------------------------------------------------------
    match /quiz_submissions/{submissionId} {
      allow read: if isTeacherOrDemo() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isTeacherOrDemo();
    }

    // ---------------------------------------------------------------------
    // 3. Quiz results
    // - Teachers can read all results
    // - Students can read their own results or results linked by email
    // - Creation allowed for the authenticated student
    // - Updates/Deletes allowed for teachers only
    // ---------------------------------------------------------------------
    match /quiz_results/{resultId} {
      allow read: if isTeacherOrDemo() || (isSignedIn() && (
        resource.data.userId == request.auth.uid ||
        resource.data.studentEmail == request.auth.token.email
      ));
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isTeacherOrDemo();
    }

    // ---------------------------------------------------------------------
    // 4. Module progress
    // - Teachers can read all progress documents
    // - Students can read/write only their own progress
    // - Deletion allowed for teachers only
    // ---------------------------------------------------------------------
    match /module_progress/{progressId} {
      allow read: if isTeacherOrDemo() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create, update: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isTeacherOrDemo();
    }
  }
}
